APP_ENV=production
APP_NAME=ai-secretary
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://ai_secretary:change-me@postgres:5432/ai_secretary
# For local development: sqlite:///./data/ai_secretary.db
API_TOKEN=replace-with-a-long-random-token
APPROVAL_SIGNING_KEY=replace-with-a-long-random-key
TELEGRAM_WEBHOOK_SECRET=replace-with-another-random-secret
TELEGRAM_OWNER_USER_ID=replace-with-telegram-user-id
APP_TIMEZONE=Europe/Moscow
APPROVAL_TTL_HOURS=24
EXECUTION_ENABLED=false
